# v850 ldl.w, stc.w, ldl.bu, ldl.hu, stc.b, stc.h, cll and the link
# mach: v850e3v5

	.include "testutils.inc"

	.macro	ldl_bu r1 r3
	.hword	0x0fe0 | \r1, (\r3 << 11) | 0x0370
	.endm
	.macro	ldl_hu r1 r3
	.hword	0x0fe0 | \r1, (\r3 << 11) | 0x0374
	.endm
	.macro	stc_b r3 r1
	.hword	0x07e0 | \r1, (\r3 << 11) | 0x0372
	.endm
	.macro	stc_h r3 r1
	.hword	0x07e0 | \r1, (\r3 << 11) | 0x0376
	.endm
	.macro	cll
	.hword	0xffff, 0xf160
	.endm

	.data
	.align	5
blk0:	.long	0x11111111, 0x22222222, 0, 0, 0, 0, 0, 0
blk1:	.long	0x33333333, 0, 0, 0, 0, 0, 0, 0
	.text

	seti	blk0, r1
	seti	blk1, r2

# success: value loaded, stored, result 1
	ldl.w	[r1], r3
	reg	r3, 0x11111111
	seti	0x44444444, r3
	stc.w	r3, [r1]
	reg	r3, 1
	ld.w	0[r1], r4
	reg	r4, 0x44444444

# the link is consumed by a successful stc
	mov	7, r3
	stc.w	r3, [r1]
	reg	r3, 0
	ld.w	0[r1], r4
	reg	r4, 0x44444444

# stc to another address fails
	ldl.w	[r1], r3
	mov	7, r3
	stc.w	r3, [r2]
	reg	r3, 0
	ld.w	0[r2], r4
	reg	r4, 0x33333333

# that failed stc also removed the link
	mov	7, r3
	stc.w	r3, [r1]
	reg	r3, 0

# a second ldl replaces the link
	ldl.w	[r1], r3
	ldl.w	[r2], r3
	mov	7, r3
	stc.w	r3, [r1]
	reg	r3, 0

# cll removes the link
	ldl.w	[r1], r3
	cll
	mov	7, r3
	stc.w	r3, [r1]
	reg	r3, 0

# a store to the same 32-byte block removes the link
	ldl.w	[r1], r3
	st.w	r0, 28[r1]
	mov	7, r3
	stc.w	r3, [r1]
	reg	r3, 0

# a store to another block keeps it
	ldl.w	[r1], r3
	st.w	r0, 4[r2]
	mov	8, r3
	stc.w	r3, [r1]
	reg	r3, 1
	ld.w	0[r1], r4
	reg	r4, 8

# a trap removes the link
	ldl.w	[r1], r3
	mov	SYS_write, r6
	mov	1, r7
	mov	r1, r8
	mov	0, r9
	trap	31
	mov	7, r3
	stc.w	r3, [r1]
	reg	r3, 0

# eiret removes the link
	stsr	psw, r5
	ldsr	r5, eipsw
	seti	1f, r5
	ldsr	r5, eipc
	ldl.w	[r1], r3
	eiret
1:	mov	7, r3
	stc.w	r3, [r1]
	reg	r3, 0

# feret removes the link
	stsr	psw, r5
	ldsr	r5, fepsw
	seti	1f, r5
	ldsr	r5, fepc
	ldl.w	[r1], r3
	feret
1:	mov	7, r3
	stc.w	r3, [r1]
	reg	r3, 0

# a size mismatch fails
	ldl.w	[r1], r3
	mov	7, r3
	stc_h	3, 1
	reg	r3, 0

# ldl.bu and stc.b
	seti	0x000000f0, r4
	st.w	r4, 0[r1]
	ldl_bu	1, 3
	reg	r3, 0xf0
	mov	0x5a, r3
	stc_b	3, 1
	reg	r3, 1
	ld.w	0[r1], r4
	reg	r4, 0x5a

# ldl.hu and stc.h
	seti	0x0000f00f, r4
	st.w	r4, 0[r1]
	ldl_hu	1, 3
	reg	r3, 0xf00f
	seti	0x1234, r3
	stc_h	3, 1
	reg	r3, 1
	ld.w	0[r1], r4
	reg	r4, 0x1234

# ldl.hu then stc.b fails
	ldl_hu	1, 3
	mov	9, r3
	stc_b	3, 1
	reg	r3, 0
	ld.w	0[r1], r4
	reg	r4, 0x1234

	pass
