# Test the v850 prologue unwinder on functions without a frame
# pointer and without CFI.

require {istarget "v850*-*-*"}

standard_testfile .c .S

if {[prepare_for_testing "failed to prepare" $testfile \
	 [list $srcfile $srcfile2] debug]} {
    return
}

if {![runto_main]} {
    return
}

gdb_breakpoint "inner"
gdb_continue_to_breakpoint "inner"

# OUTER cleared r29, which it does not use as a frame pointer.  The
# backtrace must still reach main.
gdb_test "bt" \
    [multi_line \
	 "#0\[ \t\]*$hex in inner \\\(\\\)" \
	 "#1\[ \t\]*$hex in outer \\\(\\\)" \
	 "#2\[ \t\]*$hex in main \\\(\\\) at .*$srcfile:${decimal}"] \
    "backtrace with r29 zero"

# Computing the frame id with a non-zero r29 must not fail.
gdb_test_no_output "set var \$r29 = 0x1000"
gdb_test "bt" \
    [multi_line \
	 "#0\[ \t\]*$hex in inner \\\(\\\)" \
	 "#1\[ \t\]*$hex in outer \\\(\\\)" \
	 "#2\[ \t\]*$hex in main \\\(\\\) at .*$srcfile:${decimal}"] \
    "backtrace with r29 set"
